# Copy to .env (never commit .env). Values here are for local dev only.
NODE_ENV=development
API_PORT=3100
WEB_URL=http://localhost:5180

# Two DB users on purpose: the app user owns nothing, so the append-only audit trail holds;
# migrations run as admin.
DATABASE_URL=postgres://intra_app:intra@localhost:5434/alma_intra
DATABASE_ADMIN_URL=postgres://intra_admin:intra_admin@localhost:5434/alma_intra

# Fine for local work; production refuses it. Generate with: openssl rand -base64 48
AUTH_ACCESS_SECRET=change-me-32-chars-minimum-please
# 32 random bytes, base64: openssl rand -base64 32. Encrypts the second-factor secrets.
DATA_ENCRYPTION_KEY=

AUTH_ACCESS_TTL=15m

# Without a key, e-mails stay in an in-memory outbox (dev and tests). Required in production.
RESEND_API_KEY=
# `onboarding@resend.dev` is Resend's test sender: it only delivers to the address that owns the
# Resend account. In production: an address on the verified sending subdomain.
MAIL_FROM="Alma Intra <onboarding@resend.dev>"
# Where answers to the system e-mails go. Empty = no Reply-To header.
MAIL_REPLY_TO=info@alma-care.eu

# New passwords are checked against Have I Been Pwned (only 5 hex characters of the password's
# SHA-1 are sent; fail-open when it is unreachable). Unset: `off` in tests, `hibp` else.
# PASSWORD_BREACH_CHECK=hibp

# S3-compatible object storage for the Files module: Hetzner Object Storage in production,
# SeaweedFS from docker-compose locally. All five or none: without them the Files module is
# switched off. Required in production.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=alma-intra-dev
S3_ACCESS_KEY_ID=intra-dev
S3_SECRET_ACCESS_KEY=intra-dev-secret

LOG_LEVEL=debug
